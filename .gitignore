# =============================================================================
# Operating System & Editor Files
# =============================================================================
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# =============================================================================
# Environment Variables & Secrets (Root, Frontend & Backend)
# =============================================================================
.env
.env.*
*.local
!.env.example
!Backend/.env.example
!frontend/.env.example

# =============================================================================
# Backend (Python / FastAPI / Pytest)
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/
Backend/venv/
Backend/.venv/

# Packaging & Distribution
.Python
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Runtime Uploaded Files & Generated Receipts (keep directory if needed, ignore contents)
Backend/static/uploads/*
!Backend/static/uploads/.gitkeep

# Databases & Local Logs
*.db
*.sqlite3
*.log

# =============================================================================
# Frontend (React / TypeScript / Vite / Node)
# =============================================================================
node_modules/
frontend/node_modules/

# Build Outputs
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# TypeScript Incremental Build Info
*.tsbuildinfo
frontend/*.tsbuildinfo

# NPM / Yarn / PNPM Debug Logs & Caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm
.eslintcache
.stylelintcache

# =============================================================================
# Deployment Platforms (Vercel / Render)
# =============================================================================
.vercel/
frontend/.vercel/
